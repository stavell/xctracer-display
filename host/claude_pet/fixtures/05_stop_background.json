{
 "description": "Stop with background tasks stays WORKING until the agent completes",
 "repos": {},
 "steps": [
  {
   "t": 0,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "UserPromptSubmit",
    "cwd": "/work/demo"
   }
  },
  {
   "t": 1,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Stop",
    "background_tasks": [
     {
      "id": "b1",
      "type": "shell",
      "status": "running",
      "description": "SECRET",
      "command": "SECRET"
     }
    ]
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING"
     }
    }
   }
  },
  {
   "t": 2,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Notification",
    "notification_type": "idle_prompt"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING"
     }
    }
   }
  },
  {
   "t": 50,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Notification",
    "notification_type": "agent_completed"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "DONE"
     }
    }
   }
  },
  {
   "t": 51,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Stop",
    "background_tasks": []
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "DONE"
     }
    }
   }
  }
 ]
}
