{
 "description": "PERMISSION clears on the next main-agent event",
 "repos": {},
 "steps": [
  {
   "t": 0,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "UserPromptSubmit",
    "cwd": "/work/demo"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING"
     }
    }
   }
  },
  {
   "t": 1,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash"
   }
  },
  {
   "t": 2,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PermissionRequest",
    "tool_name": "Bash"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "PERMISSION",
      "tool": "SHELL"
     }
    }
   }
  },
  {
   "t": 3,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Notification",
    "notification_type": "idle_prompt"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "PERMISSION"
     }
    }
   }
  },
  {
   "t": 60,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING"
     }
    }
   }
  },
  {
   "t": 61,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PermissionRequest",
    "tool_name": "Edit"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "PERMISSION"
     }
    }
   }
  },
  {
   "t": 62,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PermissionDenied",
    "tool_name": "Edit"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING"
     }
    }
   }
  },
  {
   "t": 63,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Notification",
    "notification_type": "permission_prompt"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "PERMISSION"
     }
    }
   }
  },
  {
   "t": 64,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING"
     }
    }
   }
  }
 ]
}
