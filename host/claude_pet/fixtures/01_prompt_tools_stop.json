{
 "description": "WORKING -> DONE -> IDLE after 20 minutes",
 "repos": {},
 "steps": [
  {
   "t": 0,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "SessionStart",
    "cwd": "/work/demo",
    "source": "startup"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "IDLE",
      "slot": 0
     }
    }
   }
  },
  {
   "t": 1,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "UserPromptSubmit",
    "cwd": "/work/demo",
    "prompt": "SECRET PROMPT"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING",
      "tool": "THINK"
     }
    }
   }
  },
  {
   "t": 2,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/secret"
    }
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING",
      "tool": "READ"
     }
    }
   }
  },
  {
   "t": 3,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PostToolUse",
    "tool_name": "Read"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING",
      "tool": "READ"
     }
    }
   }
  },
  {
   "t": 4,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING",
      "tool": "SHELL"
     }
    }
   }
  },
  {
   "t": 5,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "Stop",
    "background_tasks": [],
    "last_assistant_message": "SECRET"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "DONE"
     }
    }
   }
  },
  {
   "t": 1204,
   "tick": true,
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "DONE"
     }
    }
   }
  },
  {
   "t": 1205,
   "tick": true,
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "IDLE"
     }
    }
   }
  }
 ]
}
