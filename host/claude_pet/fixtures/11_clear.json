{
 "description": "/clear keeps slot and variant",
 "repos": {
  "/work/widgets": [
   "/repos/widgets/.git",
   "widgets"
  ],
  "/work/widgets-wt1": [
   "/repos/widgets/.git",
   "widgets"
  ],
  "/work/widgets-wt2": [
   "/repos/widgets/.git",
   "widgets"
  ],
  "/work/other": [
   "/work/other",
   "other"
  ]
 },
 "steps": [
  {
   "t": 0,
   "ev": {
    "session_id": "a",
    "hook_event_name": "SessionStart",
    "cwd": "/work/widgets",
    "source": "startup"
   }
  },
  {
   "t": 1,
   "ev": {
    "session_id": "b",
    "hook_event_name": "SessionStart",
    "cwd": "/work/widgets-wt1",
    "source": "startup"
   }
  },
  {
   "t": 2,
   "ev": {
    "session_id": "c",
    "hook_event_name": "SessionStart",
    "cwd": "/work/widgets-wt2",
    "source": "startup"
   }
  },
  {
   "t": 3,
   "ev": {
    "session_id": "b",
    "hook_event_name": "UserPromptSubmit"
   },
   "expect": {
    "sessions": {
     "b": {
      "slot": 1,
      "variant": 1,
      "state": "WORKING"
     }
    }
   }
  },
  {
   "t": 10,
   "ev": {
    "session_id": "b",
    "hook_event_name": "SessionEnd",
    "reason": "clear"
   },
   "expect": {
    "sessions": {
     "b": {
      "slot": 1
     }
    }
   }
  },
  {
   "t": 12,
   "ev": {
    "session_id": "b2",
    "hook_event_name": "SessionStart",
    "cwd": "/work/widgets-wt1",
    "source": "clear"
   },
   "expect": {
    "absent": [
     "b"
    ],
    "slots": 3,
    "sessions": {
     "b2": {
      "slot": 1,
      "variant": 1,
      "state": "IDLE",
      "label": "WIDG"
     }
    }
   }
  },
  {
   "t": 40,
   "tick": true,
   "expect": {
    "sessions": {
     "b2": {
      "slot": 1,
      "variant": 1
     }
    }
   }
  },
  {
   "t": 41,
   "ev": {
    "session_id": "b2",
    "hook_event_name": "SessionEnd",
    "reason": "clear"
   },
   "expect": {
    "slots": 3,
    "sessions": {
     "b2": {
      "state": "IDLE"
     }
    }
   }
  },
  {
   "t": 47,
   "tick": true,
   "expect": {
    "absent": [
     "b2"
    ],
    "slots": 2
   }
  }
 ]
}
