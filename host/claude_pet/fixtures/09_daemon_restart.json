{
 "description": "the first event of an unknown session recreates it",
 "repos": {},
 "steps": [
  {
   "t": 0,
   "ev": {
    "session_id": "sess-a",
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "cwd": "/work/demo"
   },
   "expect": {
    "sessions": {
     "sess-a": {
      "state": "WORKING",
      "tool": "SHELL",
      "slot": 0
     }
    }
   }
  },
  {
   "t": 1,
   "ev": {
    "session_id": "sess-b",
    "hook_event_name": "PermissionRequest",
    "tool_name": "Edit",
    "cwd": "/work/demo"
   },
   "expect": {
    "sessions": {
     "sess-b": {
      "state": "PERMISSION",
      "slot": 1
     }
    }
   }
  }
 ]
}
